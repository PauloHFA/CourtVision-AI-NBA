# Copie para .env e preencha só na sua máquina. Nunca commite segredos.
# A senha abaixo é a credencial demonstrativa do Compose local (apêndice D).
# Não reuse fora da máquina de desenvolvimento.

BDL_API_KEY=replace_me

# API rodando no host, banco no Compose publicado em 127.0.0.1:
DATABASE_URL=postgresql+psycopg://courtvision:localdev@127.0.0.1:5432/courtvision

# API rodando dentro do Compose (hostname do serviço):
# DATABASE_URL=postgresql+psycopg://courtvision:localdev@postgres:5432/courtvision

# Deixe vazio para subir a API só com o fixture sintético, sem Postgres.
# DATABASE_URL=

OLLAMA_BASE_URL=http://127.0.0.1:11434
# Dentro do Compose: http://ollama:11434
OLLAMA_CHAT_MODEL=
OLLAMA_EMBED_MODEL=

MODEL_ARTIFACT_PATH=models/champion.joblib
MODEL_VERSION=ml-0.1.0
FEATURE_VERSION=features-1
INGESTION_RATE_PER_MIN=4
API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development
FIXTURE_PATH=data/fixtures/synthetic_season.json
MIN_PRIOR_GAMES=5
API_RATE_LIMIT_PER_MIN=60
